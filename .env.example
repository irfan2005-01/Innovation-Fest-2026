# Safe, browser-visible variables only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key
VITE_UPI_ID=your-upi-id@bank
VITE_UPI_NAME="Your organisation name"

# Set these in Vercel Project Settings → Environment Variables. Never prefix
# them with VITE_, and never commit their values into this repository.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-rotated-service-role-key
# ADMIN_PASSCODE=choose-a-strong-private-passcode
# ADMIN_SESSION_SECRET=generate-a-random-32-byte-or-longer-secret
